* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
  background: #f7f4ee;
  color: #3c382c;
}

.auth-screen {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
}

.auth-hero {
  background: #f3efe6;
  color: #3c382c;
  padding: 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.auth-logo {
  width: min(420px, 100%);
  height: auto;
  display: block;
}

.auth-kicker,
.brand-kicker {
  letter-spacing: 0.34em;
  text-transform: uppercase;
  font-size: 12px;
  color: #6d675c;
}

.auth-kicker {
  margin-top: 28px;
}

.auth-rule {
  width: 72px;
  height: 1px;
  background: #4a4332;
  margin: 22px 0;
}

.auth-tagline {
  letter-spacing: 0.28em;
  text-transform: uppercase;
  font-size: 13px;
  color: #6d675c;
  margin: 0;
}

.auth-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
  background: #f7f4ee;
}

.auth-card {
  width: min(420px, 100%);
}

.page {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.page-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-end;
}

.page-header h1 {
  margin: 0;
  font-size: 28px;
}

.new-rep-form .ant-form-item {
  margin-bottom: 8px;
}

.new-rep-form .ant-form-item-label {
  padding-bottom: 2px;
}

.new-rep-form .ant-typography {
  margin-top: 12px;
  margin-bottom: 8px;
}

.new-rep-form .ant-typography:first-child {
  margin-top: 0;
}

.new-rep-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 16px;
  align-content: start;
}

.ant-layout-sider-children {
  height: 100%;
}

.app-sider {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  min-height: 100vh;
}

.app-sider-footer {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
  border-top: 1px solid #e3dcd0;
}

.brand {
  padding: 28px 20px 12px;
}

.brand-logo {
  width: 148px;
  height: auto;
  display: block;
}

.brand-kicker {
  margin-top: 10px;
}

.app-sider-profile-name {
  color: #3c382c;
  font-weight: 600;
  font-size: 14px;
}

.app-sider-profile-meta {
  color: #6d675c;
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.org-chart {
  display: flex;
  justify-content: safe center;
  overflow-x: auto;
  padding: 8px 4px 20px;
}

.org-chart ul {
  display: flex;
  justify-content: center;
  width: max-content;
  margin: 0;
  padding: 0;
  list-style: none;
}

.org-chart li {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 0 10px;
}

.org-node {
  position: relative;
  padding-top: 20px;
}

.org-chart > ul > li > .org-node {
  padding-top: 0;
}

.org-node::before,
.org-children::before {
  content: "";
  position: absolute;
  left: 50%;
  width: 1px;
  background: #b7ae9e;
}

.org-node::before {
  top: 0;
  height: 20px;
}

.org-chart > ul > li > .org-node::before {
  display: none;
}

.org-children {
  position: relative;
  padding-top: 20px;
}

.org-children::before {
  top: 0;
  height: 20px;
}

.org-children > ul > li::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: #b7ae9e;
}

.org-children > ul > li:first-child::before {
  left: 50%;
}

.org-children > ul > li:last-child::before {
  right: 50%;
}

.org-children > ul > li:only-child::before {
  display: none;
}

.org-person {
  position: relative;
  z-index: 1;
  min-width: 148px;
  padding: 12px 16px;
  border: 1px solid #d9d1c4;
  border-radius: 2px;
  background: #fffcf8;
  color: #3c382c;
  font: inherit;
  line-height: 1.3;
  cursor: pointer;
  text-align: center;
}

.org-person:hover {
  border-color: #4a4332;
}

.org-person.is-current {
  background: #4a4332;
  border-color: #4a4332;
  color: #f7f4ee;
}

.org-person-name {
  display: block;
  font-weight: 600;
}

.org-person-role {
  display: block;
  margin-top: 4px;
  color: #6d675c;
  font-size: 12px;
  letter-spacing: 0.04em;
}

.org-person.is-current .org-person-role {
  color: rgba(247, 244, 238, 0.72);
}

.page-header p {
  margin: 6px 0 0;
  color: #6d675c;
}

.brand-mark {
  font-weight: 700;
  letter-spacing: 0.14em;
}

html[data-theme="dark"] body {
  background: #1c1a16;
  color: #f3efe6;
}

html[data-theme="dark"] .auth-hero {
  background: #24211c;
  color: #f3efe6;
}

html[data-theme="dark"] .auth-panel {
  background: #1c1a16;
}

html[data-theme="dark"] .auth-kicker,
html[data-theme="dark"] .brand-kicker,
html[data-theme="dark"] .auth-tagline,
html[data-theme="dark"] .page-header p,
html[data-theme="dark"] .app-sider-profile-meta {
  color: #c4b8a2;
}

html[data-theme="dark"] .auth-rule {
  background: #c4b8a2;
}

html[data-theme="dark"] .app-sider-profile-name {
  color: #f3efe6;
}

html[data-theme="dark"] .app-sider-footer {
  border-top-color: #3d382f;
}

html[data-theme="dark"] .brand-logo,
html[data-theme="dark"] .auth-logo {
  filter: invert(1) brightness(1.35);
}

html[data-theme="dark"] .org-person {
  background: #2a261f;
  color: #f3efe6;
  border-color: #4a4332;
}

html[data-theme="dark"] .org-person-role,
html[data-theme="dark"] .org-node::before,
html[data-theme="dark"] .org-children::before,
html[data-theme="dark"] .org-children > ul > li::before {
  color: #c4b8a2;
}

html[data-theme="dark"] .org-node::before,
html[data-theme="dark"] .org-children::before,
html[data-theme="dark"] .org-children > ul > li::before {
  background: #6d675c;
}

html[data-theme="dark"] .org-person.is-current {
  background: #c4b8a2;
  border-color: #c4b8a2;
  color: #1c1a16;
}

html[data-theme="dark"] .org-person.is-current .org-person-role {
  color: #3c382c;
}

@media (max-width: 800px) {
  .auth-screen {
    grid-template-columns: 1fr;
  }

  .auth-hero {
    padding: 32px 24px;
  }

  .auth-hero h1 {
    font-size: 36px;
  }

}
